---
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>;
  /** Never indexed and no canonical URL, even in prod (404 page) */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  type = "website",
  jsonLd,
  noindex = false,
} = Astro.props;
const indexable = SITE.isProd && !noindex;
const fullTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const url = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image && new URL(image, Astro.site);

// Search snippets get cut around 155 characters
function clip(text: string, max = 155) {
  if (text.length <= max) return text;
  return text.slice(0, text.lastIndexOf(" ", max - 1)).replace(/[\s,.;:-]+$/, "") + "…";
}
const desc = clip(description);
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
{indexable ? <link rel="canonical" href={url} /> : <meta name="robots" content="noindex" />}
<meta property="og:site_name" content={SITE.title} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={desc} />
{indexable && <meta property="og:url" content={url} />}
<meta property="og:locale" content="en" />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && <meta property="og:image:width" content="1200" />}
{imageUrl && <meta property="og:image:height" content="630" />}
<meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
