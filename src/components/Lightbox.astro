---
// Full-size viewer for [data-lightbox] links. Without JS the links simply
// open the large JPEG.
---

<dialog class="lightbox" aria-label="Image viewer" data-lightbox-dialog>
  <figure>
    <img alt="" />
    <figcaption><span class="count" aria-live="polite"></span></figcaption>
  </figure>
  <button type="button" class="lb-close" aria-label="Close">×</button>
  <button type="button" class="lb-prev" aria-label="Previous image">‹</button>
  <button type="button" class="lb-next" aria-label="Next image">›</button>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    border: 0;
    background: rgb(255 255 255 / 0.97);
    padding: 3rem 4rem;
  }
  .lightbox::backdrop {
    background: rgb(255 255 255 / 0.9);
  }
  figure {
    height: 100%;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    place-items: center;
    gap: 0.75rem;
  }
  img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    touch-action: pan-y;
  }
  figcaption {
    font-size: 14px;
    color: var(--muted);
  }
  button {
    position: absolute;
    border: 0;
    background: none;
    cursor: pointer;
    font-size: 40px;
    line-height: 1;
    width: 48px;
    height: 48px;
  }
  .lb-close {
    top: 0.5rem;
    right: 0.5rem;
  }
  .lb-prev,
  .lb-next {
    top: calc(50% - 24px);
  }
  .lb-prev {
    left: 0.5rem;
  }
  .lb-next {
    right: 0.5rem;
  }
  @media (max-width: 40rem) {
    .lightbox {
      padding: 3rem 0.5rem;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 0.5rem;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox-dialog]");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-lightbox]")];

  if (dialog && links.length) {
    const img = dialog.querySelector("img")!;
    const count = dialog.querySelector(".count")!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>(".lb-prev")!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>(".lb-next")!;
    let index = 0;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const d = links[index].dataset;
      img.removeAttribute("srcset");
      img.src = d.src!;
      img.srcset = d.srcset!;
      img.sizes = "100vw";
      img.alt = d.alt!;
      img.width = Number(d.width);
      img.height = Number(d.height);
      count.textContent = `${index + 1} / ${links.length}`;
    };

    const single = links.length === 1;
    prevBtn.hidden = nextBtn.hidden = single;

    links.forEach((a, i) =>
      a.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    prevBtn.addEventListener("click", () => show(index - 1));
    nextBtn.addEventListener("click", () => show(index + 1));
    dialog.querySelector(".lb-close")!.addEventListener("click", () => dialog.close());
    // Click on the backdrop area (not the image or buttons) closes
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog || (e.target as Element).tagName === "FIGURE") dialog.close();
    });
    dialog.addEventListener("keydown", (e) => {
      if (single) return;
      if (e.key === "ArrowLeft") show(index - 1);
      if (e.key === "ArrowRight") show(index + 1);
    });
    dialog.addEventListener("close", () => links[index].focus());

    let startX: number | null = null;
    img.addEventListener("pointerdown", (e) => (startX = e.clientX));
    img.addEventListener("pointerup", (e) => {
      if (startX === null || single) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>
