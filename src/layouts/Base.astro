---
import { Font } from "astro:assets";
import Seo from "../components/Seo.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

type Props = Parameters<typeof Seo>[0] & { pageClass?: string };
const { pageClass, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <Font cssVariable="--font-din" preload={[{ weight: 500 }]} />
    <Seo {...seo} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class:list={["layout", pageClass]}>
      <header class="site-header">
        <a class="logo" href="/" aria-label="2083, home">2083</a>
        <slot name="header" />
      </header>
      <main>
        <section class="panel" id="content" tabindex="-1">
          <slot name="panel" />
        </section>
        <div class="media">
          <slot />
        </div>
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
